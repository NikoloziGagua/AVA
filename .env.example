# Server
PORT=8787
TAILSCALE_IP=100.0.0.0
DATA_DIR=./data
LOG_LEVEL=info

# Auth — generated, not user-set
AUTH_PAIRING_TTL_SECONDS=300

# OpenAI (M3)
OPENAI_API_KEY=

# Anthropic (metered calls — title/summary/rule-parse, M2+)
ANTHROPIC_API_KEY=

# Claude Code worker auth — inherits from `claude` CLI login

# ─── Voice mode ──────────────────────────────────────────────────────────────
# Voice is transcribe-only: the OpenAI realtime model does VAD + speech-to-text,
# never speaks. Accepted transcripts route through POST /api/chat (the full
# tool-using agent) and replies are spoken via TTS. The knobs below tune the two
# guards that stop silence/noise from becoming a phantom user turn.

# Realtime upstream VAD + transcription (server/src/routes/voice-realtime.ts)
# REALTIME_MODEL=gpt-realtime                 # realtime session model
# REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe # STT model (hallucinates < whisper-1)
# REALTIME_VAD_THRESHOLD=0.6                  # 0..1 energy gate; higher = ignore more noise
# REALTIME_VAD_PREFIX_PADDING_MS=300          # audio kept before speech onset
# REALTIME_VAD_SILENCE_MS=600                 # trailing silence that ends a turn (min silence)

# Transcript gate — drops empty/short/low-confidence/hallucinated transcripts
# (server/src/voice/transcript-gate.ts)
# VOICE_MIN_CHARS=2                           # reject transcripts shorter than this
# VOICE_MIN_SPEECH_MS=200                     # reject speech blips shorter than this
# VOICE_MAX_NO_SPEECH_PROB=0.6                # reject when transcriber says it's likely silence
# VOICE_MIN_AVG_LOGPROB=-1.2                  # reject very low-confidence transcripts
# VOICE_HALLUCINATION_PHRASES=you,thank you,thanks for watching,okay,so,uh,um  # comma-separated denylist
