# Server
PORT=8787
# Optional: set this to this PC's real Tailscale IPv4 address for phone access.
# Leave unset for localhost-only access. Do not use the placeholder 100.0.0.0.
# TAILSCALE_IP=100.x.y.z
# Relative paths are resolved from server/, so this is always server/data.
DATA_DIR=./data
LOG_LEVEL=info

# Auth — generated, not user-set
AUTH_PAIRING_TTL_SECONDS=300

# OpenAI (M3)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Anthropic (metered calls — title/summary/rule-parse, M2+)
ANTHROPIC_API_KEY=

# Claude Code worker auth — inherits from `claude` CLI login

# ─── Voice mode ──────────────────────────────────────────────────────────────
# OpenAI Realtime owns one continuous speech-to-speech voice. Chit-chat stays
# realtime; actions cross do_on_computer into AVA's normal GPT-5.6 tool agent,
# then the result returns to the same realtime voice. The knobs below tune the
# transcript gate and endpointing.

# Realtime upstream VAD + transcription (server/src/routes/voice-realtime.ts)
# REALTIME_MODEL=gpt-realtime-2.1             # latest full realtime voice model
# REALTIME_VOICE=marin                        # OpenAI-recommended high-quality voice
# REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe # STT model (hallucinates < whisper-1)
# REALTIME_TRANSCRIBE_LANGUAGE=en              # ISO-639-1 hint; use auto to omit
# REALTIME_VAD_MODE=semantic_vad              # default; avoids splitting requests at short pauses
# REALTIME_VAD_EAGERNESS=low                  # patient endpointing: low|medium|high|auto
# REALTIME_VAD_THRESHOLD=0.6                  # server_vad fallback only
# REALTIME_VAD_PREFIX_PADDING_MS=300          # server_vad fallback only
# REALTIME_VAD_SILENCE_MS=600                 # server_vad fallback base

# REALTIME_HYBRID is retired; speech-to-speech plus the action bridge is now the
# only supported pipeline.

# Realtime voice PROVIDER (server/src/routes/voice-provider-config.ts).
# Default is OpenAI. Set to "hume" to speak Hume EVI instead — used ONLY when
# HUME_API_KEY is also set, otherwise it transparently falls back to OpenAI.
# See server/src/routes/voice-realtime.md for setup.
# AVA_VOICE_PROVIDER=openai          # openai (default) | hume
# HUME_API_KEY=                      # required for the hume provider
# HUME_CONFIG_ID=                    # optional EVI config id
# HUME_VOICE_NAME=Alice Bennett      # optional; defaults to Alice Bennett
# HUME_VOICE_ID=                     # optional; exact voice id (preferred over name)

# Transcript gate — drops empty/short/low-confidence/hallucinated transcripts
# (server/src/voice/transcript-gate.ts)
# VOICE_MIN_CHARS=2                           # reject transcripts shorter than this
# VOICE_MIN_SPEECH_MS=200                     # reject speech blips shorter than this
# VOICE_MAX_NO_SPEECH_PROB=0.6                # reject when transcriber says it's likely silence
# VOICE_MIN_AVG_LOGPROB=-1.2                  # reject very low-confidence transcripts
# VOICE_HALLUCINATION_PHRASES=you,thank you,thanks for watching,okay,so,uh,um  # comma-separated denylist

# Dedicated persistent browser for Instagram, WhatsApp, Gmail, Calendar, etc.
# Run scripts/start-ava-browser.ps1 once, then log into each service in that window.
# CHROME_CDP_URL=http://127.0.0.1:9222
# CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
