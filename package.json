{
  "name": "ava",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "m0-spike",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spike": "npm -w m0-spike run start",
    "server:dev": "npm -w server run dev",
    "server:test": "npm -w server run test",
    "web:dev": "npm -w web run dev",
    "web:build": "npm -w web run build",
    "codex:trust-watch": "node scripts/trust-codex-watch-hook.mjs",
    "test:explorer-contract": "npm -w server run build && node node_modules/typescript/bin/tsc -b web/tsconfig.json --pretty false && node scripts/validate-explorer-contract.mjs && node scripts/explorer-reality-check.mjs --emit",
    "test": "npm -w server run test && npm -w web run test",
    "test:e2e": "vitest run --root . --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^24.0.0",
    "playwright": "^1.59.1",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
