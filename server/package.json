{
  "name": "ava-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && node -e \"const fs=require('node:fs'),crypto=require('node:crypto');fs.copyFileSync('src/state/schema.sql','dist/state/schema.sql');fs.copyFileSync('src/self/SELF.md','dist/self/SELF.md');fs.writeFileSync('dist/build-id.txt',crypto.randomUUID()+'\\n')\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:memory-retrieval": "tsx scripts/memory-retrieval-smoke.ts",
    "pair": "tsx scripts/mint-pairing-code.ts",
    "self:loop": "tsx scripts/auto-improve-loop.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "openai": "^6.35.0",
    "picomatch": "^4.0.4",
    "pino": "^9.5.0",
    "pino-roll": "^4.0.0",
    "playwright": "^1.59.1",
    "systray2": "^2.1.4",
    "tree-kill": "^1.2.2",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/picomatch": "^4.0.3",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "vitest": "^2.1.4"
  }
}
