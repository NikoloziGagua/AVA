{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/codex-watch-stop-hook.mjs server/data/codex-watch-inbox",
            "timeout": 420,
            "statusMessage": "Checking for an AVA watcher handoff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nikug/ai/AVA/.agentroom/agentroom.mjs\" hook stop --agent codex --binding 2938e6f7-923b-4aca-b16f-0c7445705335",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nikug/ai/AVA/.agentroom/agentroom.mjs\" hook session-start --agent codex --binding 2938e6f7-923b-4aca-b16f-0c7445705335",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nikug/ai/AVA/.agentroom/agentroom.mjs\" hook pre-edit --agent codex --binding 2938e6f7-923b-4aca-b16f-0c7445705335",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nikug/ai/AVA/.agentroom/agentroom.mjs\" hook inbox --agent codex --binding 2938e6f7-923b-4aca-b16f-0c7445705335",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
